# Multi-stage build for Unicity Explorer with integrated nginx
FROM node:18-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git

WORKDIR /workspace

# Copy package files (including lock files if they exist)
COPY package*.json pnpm-lock.yaml* ./

# Install dependencies (npm install will use lock file if present)
RUN npm install --omit=dev

# Copy application code
COPY . .

# Build CSS files if needed
RUN npm run css || true

# Production stage with nginx included
FROM node:18-alpine

# Install runtime dependencies including nginx
RUN apk add --no-cache \
    git \
    nginx \
    tini && \
    # Create nginx directories that may not exist
    mkdir -p /run/nginx /etc/nginx/ssl /etc/nginx/conf.d /var/cache/nginx /var/lib/nginx/tmp && \
    # Create non-root user (use higher GID/UID to avoid conflicts)
    addgroup -g 10001 explorer && \
    adduser -u 10001 -G explorer -s /bin/sh -D explorer && \
    # Give explorer user access to nginx group
    addgroup explorer nginx && \
    # Set permissions for nginx directories
    chown -R explorer:explorer /run/nginx /var/lib/nginx /var/log/nginx && \
    chown -R explorer:explorer /etc/nginx/ssl /etc/nginx/conf.d && \
    chmod 755 /var/lib/nginx /var/log/nginx /etc/nginx/conf.d

WORKDIR /workspace

# Copy from builder
COPY --from=builder --chown=explorer:explorer /workspace/node_modules ./node_modules
COPY --chown=explorer:explorer . .

# Copy entrypoint script
COPY --chown=explorer:explorer docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create data directory
RUN mkdir -p /workspace/data && \
    chown -R explorer:explorer /workspace/data

# Configure nginx for non-root operation
RUN rm -f /etc/nginx/conf.d/default.conf && \
    # Remove user directive since we run as non-root
    sed -i '/^user /d' /etc/nginx/nginx.conf && \
    # Update pid file location
    sed -i 's|/var/run/nginx.pid|/run/nginx/nginx.pid|' /etc/nginx/nginx.conf && \
    # Set temp paths to writable locations
    sed -i '/^http {/a \    client_body_temp_path /var/lib/nginx/tmp/client_body;\n    proxy_temp_path /var/lib/nginx/tmp/proxy;\n    fastcgi_temp_path /var/lib/nginx/tmp/fastcgi;\n    uwsgi_temp_path /var/lib/nginx/tmp/uwsgi;\n    scgi_temp_path /var/lib/nginx/tmp/scgi;' /etc/nginx/nginx.conf && \
    # Ensure nginx loads conf.d files
    grep -q "include /etc/nginx/conf.d/\*.conf;" /etc/nginx/nginx.conf || \
    sed -i '/^http {/a \    include /etc/nginx/conf.d/*.conf;' /etc/nginx/nginx.conf

# Switch to non-root user
USER explorer

# Expose ports (80 for HTTP, 443 for HTTPS, 3002 for direct access)
EXPOSE 80 443 3002

# Health check (check nginx)
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s \
    CMD wget -q -O /dev/null http://localhost:80 || wget -q -O /dev/null http://localhost:3002/api/status || exit 1

# Use tini as PID 1
ENTRYPOINT ["/sbin/tini", "--"]

# Run the entrypoint script
CMD ["/entrypoint.sh"]