# Simple Dockerfile for Unicity Explorer with built-in SSL support
FROM node:18-alpine

# Install runtime dependencies
RUN apk add --no-cache \
    git \
    tini

WORKDIR /workspace

# Copy package files
COPY package*.json pnpm-lock.yaml* ./

# Install dependencies
RUN npm install --omit=dev || npm install --production

# Copy application code
COPY . .

# Make the SSL-enabled binary executable
RUN chmod +x /workspace/bin/www-ssl

# Create data directory
RUN mkdir -p /workspace/data

# Expose ports (80 for HTTP/redirect, 443 for HTTPS, 3002 for direct HTTP)
EXPOSE 80 443 3002

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s \
    CMD node -e "require('http').get('http://localhost:3002/api/status', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

# Use tini as PID 1
ENTRYPOINT ["/sbin/tini", "--"]

# Run the SSL-aware server
CMD ["node", "/workspace/bin/www-ssl"]