# Unicity Explorer Configuration for alpha-net Docker network
# This configuration is for running alongside Fulcrum and Alpha node in Docker

# Coin Configuration
BTCEXP_COIN=ALPHA

# Base URL (if running behind a proxy)
#BTCEXP_BASEURL=/

# Host and Port binding
BTCEXP_HOST=0.0.0.0
BTCEXP_PORT=3002

# Alpha Node RPC Configuration
# When running in alpha-net, use the container name
BTCEXP_BITCOIND_HOST=alpha-node
BTCEXP_BITCOIND_PORT=8589
#BTCEXP_BITCOIND_USER=rpcusername
#BTCEXP_BITCOIND_PASS=rpcpassword

# Electrum/Fulcrum Server Configuration
# Use local Fulcrum container in alpha-net
BTCEXP_ADDRESS_API=electrum
BTCEXP_ELECTRUM_SERVERS=tcp://fulcrum-alpha:50001

# Or use the public Fulcrum server
#BTCEXP_ELECTRUM_SERVERS=tls://fulcrum.unicity.network:50002

# Enable Electrum txindex for full transaction lookups
BTCEXP_ELECTRUM_TXINDEX=true

# RPC Work Queue
BTCEXP_RPC_CONCURRENCY=10

# Optional Redis Cache
#BTCEXP_REDIS_URL=redis://redis:6379

# Session Secret (change this in production!)
BTCEXP_COOKIE_SECRET=changeme_$(openssl rand -hex 32)

# Logging
DEBUG=btcexp:app,btcexp:error

# Demo mode
BTCEXP_DEMO=false

# Privacy mode
BTCEXP_PRIVACY_MODE=false

# Slow device mode
BTCEXP_SLOW_DEVICE_MODE=false

# UI Theme
BTCEXP_UI_THEME=dark

# Node ENV
NODE_ENV=production