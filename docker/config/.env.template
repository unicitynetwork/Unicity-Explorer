# Unicity Explorer Configuration
# This is the default configuration for Docker deployment

# Coin Configuration
BTCEXP_COIN=ALPHA

# Base URL (if running behind a proxy)
#BTCEXP_BASEURL=/

# Host and Port binding
BTCEXP_HOST=0.0.0.0
BTCEXP_PORT=3002

# Alpha Node RPC Configuration
# When running in Docker with --network host, use localhost
# When running in Docker network, use host.docker.internal or gateway IP
BTCEXP_BITCOIND_HOST=host.docker.internal
BTCEXP_BITCOIND_PORT=8589
#BTCEXP_BITCOIND_USER=rpcusername
#BTCEXP_BITCOIND_PASS=rpcpassword
#BTCEXP_BITCOIND_COOKIE=/path/to/.cookie

# Electrum/Fulcrum Server Configuration
# Default: localhost Fulcrum without SSL
BTCEXP_ADDRESS_API=electrum
BTCEXP_ELECTRUM_SERVERS=tcp://localhost:50001

# Alternative Fulcrum servers:
# Public Fulcrum with SSL:
#BTCEXP_ELECTRUM_SERVERS=tls://fulcrum.unicity.network:50002
# Docker host (when not using host network):
#BTCEXP_ELECTRUM_SERVERS=tcp://host.docker.internal:50001

# Enable Electrum txindex for full transaction lookups
BTCEXP_ELECTRUM_TXINDEX=true

# RPC Work Queue
BTCEXP_RPC_CONCURRENCY=10

# Optional Redis Cache
#BTCEXP_REDIS_URL=redis://host.docker.internal:6379

# Session Secret (change this in production!)
BTCEXP_COOKIE_SECRET=changeme_$(openssl rand -hex 32)

# SSL Configuration (set by run scripts when using SSL)
#BTCEXP_SECURE_SITE=true
#BTCEXP_TRUST_PROXY=true

# Logging
DEBUG=btcexp:app,btcexp:error

# Demo mode
BTCEXP_DEMO=false

# Privacy mode
BTCEXP_PRIVACY_MODE=false

# Slow device mode
BTCEXP_SLOW_DEVICE_MODE=false

# No rates
#BTCEXP_NO_RATES=true

# UI Theme
BTCEXP_UI_THEME=dark

# Node ENV
NODE_ENV=production